{
  "name": "wenfang-themes",
  "version": "0.1.0",
  "description": "Wenfang · 文房六色 — a Chinese-aesthetic appearance theme series for DeepSeek Harness (and its Codex port). 墨、纸、海、瓷六种气质，深浅各半。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "theme",
    "wenfang",
    "文房六色"
  ],
  "author": "zhangcaiqian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangcaiqian/wenfang-themes.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
